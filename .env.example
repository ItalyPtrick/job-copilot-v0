# chat model
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# embedding model (可与 chat 走不同端点)
OPENAI_EMBEDDING_API_KEY=your_embedding_api_key_here
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# database — 本地开发默认 SQLite，Docker Compose 会覆盖为 PostgreSQL
DATABASE_URL=sqlite:///./job_copilot.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/job_copilot

# PostgreSQL 密码（Docker Compose 读取，本地开发可忽略）
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
